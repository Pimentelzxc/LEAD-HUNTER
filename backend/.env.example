# Back-end Node/Vercel. Não são variáveis VITE_*.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
# auto escolhe Geoapify quando a chave estiver presente; sem chave usa Overpass.
MAPS_PROVIDER=auto
# Chave exclusiva do back-end, criada no plano Free (não cadastrar cartão).
GEOAPIFY_API_KEY=
# Opcional: URL pública completa do projeto. O padrão identifica este repositório.
APP_URL=
PORT=3001
# Não é necessário cartão ou chave Google.
